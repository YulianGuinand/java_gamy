<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" stylesheets="@../styles/gamy.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamy.controllers.FriendLibraryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="titleLabel" styleClass="header-label" text="Bibliothèque de l'ami" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TableView fx:id="gamesTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="gameTitleColumn" text="Jeu" prefWidth="180.0" />
                <TableColumn fx:id="modeColumn" text="Mode" prefWidth="90.0" />
                <TableColumn fx:id="priceColumn" text="Prix" prefWidth="80.0" />
                <TableColumn fx:id="statusColumn" text="Statut" prefWidth="90.0" />
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250.0" />
            </columns>
        </TableView>
    </children>
</VBox>