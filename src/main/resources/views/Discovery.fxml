<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" stylesheets="@../styles/gamy.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamy.controllers.DiscoveryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Découvrir de Nouveaux Jeux" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
    <Label fx:id="feedbackLabel" textFill="RED" />

    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Rechercher sur RAWG..." HBox.hgrow="ALWAYS" />
        <Button text="Rechercher" onAction="#handleSearch" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
    </HBox>

    <SplitPane dividerPositions="0.4" VBox.vgrow="ALWAYS">
        <ListView fx:id="resultsListView" />

        <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #fdfdfd;">
            <Label fx:id="detailTitleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sélectionnez un jeu" />
            
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Mode :" />
                <ComboBox fx:id="detailModeComboBox" promptText="Mode" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Prix (€) :" />
                <TextField fx:id="detailPriceField" promptText="0.0" />
            </HBox>

            <Label text="Description :" style="-fx-font-weight: bold;" />
            <TextArea fx:id="detailDescriptionArea" wrapText="true" VBox.vgrow="ALWAYS" />
        </VBox>
    </SplitPane>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Statut dans ma bibliothèque :" />
        <ComboBox fx:id="statusComboBox" promptText="Sélectionner un statut" />
        <Button text="Ajouter à ma bibliothèque" onAction="#handleAddToLibrary" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
    </HBox>
</VBox>