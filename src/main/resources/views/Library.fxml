<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamy.controllers.LibraryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Ma Bibliothèque">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    
    <Label fx:id="feedbackLabel" textFill="RED" />

    <TableView fx:id="libraryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Titre du Jeu" prefWidth="180" />
            <TableColumn fx:id="modeColumn" text="Mode" prefWidth="90" />
            <TableColumn fx:id="priceColumn" text="Prix (€)" prefWidth="80" />
            <TableColumn fx:id="statusColumn" text="Statut" prefWidth="90" />
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250" />
        </columns>
    </TableView>

    <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
        <Label text="Modifier le jeu sélectionné" style="-fx-font-weight: bold;" />
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Statut :" />
            <ComboBox fx:id="editStatusComboBox" />
            <Label text="Mode :" />
            <ComboBox fx:id="editModeComboBox" />
            <Label text="Prix (€) :" />
            <TextField fx:id="editPriceField" prefWidth="80.0" />
        </HBox>
        
        <VBox spacing="5.0">
            <Label text="Description :" />
            <TextArea fx:id="editDescriptionArea" prefHeight="70.0" wrapText="true" />
        </VBox>

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button text="Modifier" onAction="#handleUpdateEntry" style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
            <Button text="Supprimer de ma bibliothèque" onAction="#handleDeleteEntry" style="-fx-background-color: #c0392b; -fx-text-fill: white;" />
        </HBox>
    </VBox>
</VBox>